---
import Layout from "../layouts/Layout.astro";
import "../styles/global.css";

const skills = [
  "Python", "Django", "PHP", "Laravel", "REST APIs",
  "PostgreSQL", "MySQL", "Redis", "Docker", "Git", "CI/CD"
];

const projects = [
  {
    title: "JobSmartAI",
    description: "An AI-assisted job matching project using Django, embeddings, Qdrant and local LLMs.",
    url: "https://github.com/mahmoudbarzegar/jobsmartai"
  },
  {
    title: "Tech With Mahmoud",
    description: "Practical software engineering examples covering Python, Laravel, Linux, DevOps and AI.",
    url: "https://github.com/mahmoudbarzegar/techwithmahmoud"
  },
  {
    title: "Python Clean Architecture",
    description: "A practical example of applying Clean Architecture principles in Python.",
    url: "https://github.com/mahmoudbarzegar/python_clean_architecture"
  }
];
---

<Layout>
  <header class="site-header">
    <nav class="nav container">
      <a class="brand" href="/">Mahmoud<span>.</span></a>
      <div class="nav-links">
        <a href="#about">About</a>
        <a href="#experience">Experience</a>
        <a href="#projects">Projects</a>
        <a href="#content">Content</a>
        <a href="#contact">Contact</a>
      </div>
    </nav>
  </header>

  <main>
    <section class="hero container">
      <p class="eyebrow">TECHNICAL TEAM LEADER · BACKEND ENGINEER</p>
      <h1>Building reliable software<br /><span>with people and technology.</span></h1>
      <p class="hero-text">
        I'm Mahmoud Barzegar, a Technical Team Leader and experienced backend developer
        focused on Python, Django, PHP and Laravel.
      </p>
      <div class="actions">
        <a class="button primary" href="#projects">View projects</a>
        <a class="button secondary" href="https://github.com/mahmoudbarzegar" target="_blank" rel="noreferrer">GitHub ↗</a>
      </div>
    </section>

    <section id="about" class="section container">
      <div class="section-label">01 / ABOUT</div>
      <div class="section-content two-column">
        <div>
          <h2>Engineering with a team mindset.</h2>
        </div>
        <div>
          <p>
            I work across backend development, technical leadership and software quality.
            I enjoy solving practical engineering problems, improving development processes,
            reviewing code and helping teams deliver maintainable software.
          </p>
          <div class="skills">
            {skills.map((skill) => <span>{skill}</span>)}
          </div>
        </div>
      </div>
    </section>

    <section id="experience" class="section section-alt">
      <div class="container">
        <div class="section-label">02 / EXPERIENCE</div>
        <div class="timeline">
          <article class="timeline-item">
            <div class="timeline-date">CURRENT</div>
            <div>
              <h3>Technical Team Leader</h3>
              <p class="muted">Team leadership · Backend development · Code review · Planning</p>
              <p>
                Supporting the team with technical challenges, task planning, code reviews,
                software quality and delivery.
              </p>
            </div>
          </article>

          <article class="timeline-item">
            <div class="timeline-date">PREVIOUS</div>
            <div>
              <h3>Backend / Full-Stack Developer</h3>
              <p class="muted">PHP · Laravel · React · REST APIs · Databases</p>
              <p>
                Built and maintained backend systems, APIs, integrations and business
                applications for different products and customers.
              </p>
            </div>
          </article>
        </div>
      </div>
    </section>

    <section id="projects" class="section container">
      <div class="section-label">03 / PROJECTS</div>
      <div class="section-heading">
        <h2>Things I'm building.</h2>
        <a href="https://github.com/mahmoudbarzegar" target="_blank" rel="noreferrer">All GitHub projects ↗</a>
      </div>

      <div class="project-grid">
        {projects.map((project) => (
          <a class="project-card" href={project.url} target="_blank" rel="noreferrer">
            <div class="project-number">↗</div>
            <h3>{project.title}</h3>
            <p>{project.description}</p>
          </a>
        ))}
      </div>
    </section>

    <section id="content" class="section section-alt">
      <div class="container">
        <div class="section-label">04 / CONTENT</div>
        <div class="content-grid">
          <a class="content-card" href="https://www.youtube.com/@techwithmahmoud" target="_blank" rel="noreferrer">
            <span>YOUTUBE</span>
            <h3>Tech With Mahmoud</h3>
            <p>Practical software engineering content about Python, Laravel, DevOps and AI.</p>
            <strong>Visit channel ↗</strong>
          </a>
          <a class="content-card" href="https://www.linkedin.com/in/mahmoud-barzegar/" target="_blank" rel="noreferrer">
            <span>LINKEDIN</span>
            <h3>Technical notes &amp; career</h3>
            <p>Sharing engineering ideas, lessons learned and professional updates.</p>
            <strong>Connect on LinkedIn ↗</strong>
          </a>
        </div>
      </div>
    </section>

    <section id="contact" class="section container contact">
      <div class="section-label">05 / CONTACT</div>
      <h2>Let's connect.</h2>
      <p>
        If you're interested in software engineering, technical leadership,
        collaboration or a professional opportunity, feel free to reach out.
      </p>
      <div class="contact-links">
        <a href="https://www.linkedin.com/in/mahmoud-barzegar/" target="_blank" rel="noreferrer">LinkedIn ↗</a>
        <a href="https://github.com/mahmoudbarzegar" target="_blank" rel="noreferrer">GitHub ↗</a>
        <a href="mailto:hello@mbarzegar.ir">Email ↗</a>
      </div>
    </section>
  </main>

  <footer class="footer">
    <div class="container">
      <span>© {new Date().getFullYear()} Mahmoud Barzegar</span>
      <span>Built with Astro · Hosted on GitHub Pages</span>
    </div>
  </footer>
</Layout>